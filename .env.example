# Enterprise Data Gaps Discovery Agent
# Copy to .env for local runs. Do not put real secrets here.
# The home lab uses local SQLite files only.

SYSTEMS_DIR=data/systems
AUDIT_LOG_PATH=logs/mcp_audit.jsonl
QUERY_ROW_LIMIT=100
QUERY_ROW_LIMIT_MAX=200

# Optional. When set, the reporter asks a local Ollama model to phrase the summary.
# The findings still come from the specialists if this is unset or Ollama is down.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
